<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/anda_bg">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/anda_navy">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp"
            android:paddingTop="20dp" android:paddingBottom="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/apr_header_title" android:textColor="@color/white"
                android:textSize="26sp" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/doc_apr_desc"
                android:textColor="@color/anda_navy_text_sub" android:textSize="13sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="16dp" android:paddingBottom="40dp">

            <!-- Empresa -->
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
                android:layout_height="wrap_content" app:cardCornerRadius="20dp"
                app:cardElevation="2dp" android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/apr_company_section_title" android:textColor="@color/anda_navy"
                        android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:hint="@string/generic_doc_missing_cnpj"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/aprCnpjInput" android:layout_width="match_parent"
                                android:layout_height="wrap_content" android:inputType="number" android:maxLength="18"/>
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/aprLookupCnpjButton" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginStart="8dp"
                            android:layout_gravity="center_vertical" android:text="@string/generic_doc_lookup_button"
                            style="@style/Widget.Material3.Button.TonalButton"/>
                    </LinearLayout>
                    <TextView android:id="@+id/aprCnpjStatusText" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text=""
                        android:textColor="@color/anda_navy_medium" android:textSize="12sp"
                        android:layout_marginBottom="4dp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/aprPickCompanyButton"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/doc_pick_company_button" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="@string/generic_doc_hint_company_name" style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="8dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/aprCompanyNameInput" android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="@string/generic_doc_hint_company_cnae" style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/aprCnaeInput" android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Atividade / Riscos -->
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
                android:layout_height="wrap_content" app:cardCornerRadius="20dp"
                app:cardElevation="2dp" android:layout_marginBottom="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/apr_task_section_title" android:textColor="@color/anda_navy"
                        android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="@string/apr_hint_task_name"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="8dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/aprTaskNameInput" android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="@string/generic_doc_hint_responsible"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="8dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/aprTechnicianInput" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:inputType="textPersonName|textCapWords"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="@string/apr_hint_authorizations"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/aprAuthorizationsInput" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:minLines="3"
                            android:gravity="top" android:inputType="textMultiLine"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton android:id="@+id/generateAprButton"
                android:layout_width="match_parent" android:layout_height="56dp"
                android:text="@string/apr_generate_button" android:textSize="15sp"
                android:layout_marginBottom="10dp" style="@style/Widget.Anda.Button"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/signAprButton"
                android:layout_width="match_parent" android:layout_height="50dp"
                android:text="@string/apr_sign_button" android:layout_marginBottom="8dp"
                style="@style/Widget.Material3.Button.TonalButton"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/exportAprPdfButton"
                android:layout_width="match_parent" android:layout_height="50dp"
                android:text="@string/apr_export_button" android:layout_marginBottom="16dp"
                style="@style/Widget.Material3.Button.OutlinedButton"/>

            <TextView
                android:id="@+id/aprRequiredSummaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/apr_required_ready"
                android:textColor="@color/anda_text_secondary"
                android:textSize="12sp"/>

            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
                android:layout_height="wrap_content" app:cardCornerRadius="16dp" app:cardElevation="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp">
                    <TextView android:id="@+id/aprStatusText" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="@string/apr_status_waiting"
                        android:textColor="@color/anda_text_secondary" android:textSize="13sp"/>
                    <TextView android:id="@+id/aprPreviewText" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text=""
                        android:textColor="@color/anda_text_secondary" android:textSize="11sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>

