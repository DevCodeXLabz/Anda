<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/anda_bg">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/anda_navy">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp"
            android:paddingTop="20dp" android:paddingBottom="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/pcmso_header_title" android:textColor="@color/white"
                android:textSize="26sp" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/pcmso_subtitle"
                android:textColor="@color/anda_navy_text_sub" android:textSize="13sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="16dp" android:paddingBottom="40dp">

            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
                android:layout_height="wrap_content" app:cardCornerRadius="20dp"
                app:cardElevation="2dp" android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/pcmso_company_section" android:textColor="@color/anda_navy"
                        android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:hint="@string/generic_doc_hint_company_cnpj"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/pcmsoCnpjInput" android:layout_width="match_parent"
                                android:layout_height="wrap_content" android:inputType="number" android:maxLength="18"/>
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/pcmsoLookupCnpjButton" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:layout_marginStart="8dp"
                            android:layout_gravity="center_vertical" android:text="@string/generic_doc_lookup_button"
                            style="@style/Widget.Material3.Button.TonalButton"/>
                    </LinearLayout>
                    <TextView android:id="@+id/pcmsoCnpjStatusText" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text=""
                        android:textColor="@color/anda_navy_medium" android:textSize="12sp"
                        android:layout_marginBottom="4dp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pcmsoPickCompanyButton"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/doc_pick_company_button" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="@string/generic_doc_hint_company_name" style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="8dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/pcmsoCompanyNameInput" android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="@string/generic_doc_hint_company_cnae" style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/pcmsoCnaeInput" android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
                android:layout_height="wrap_content" app:cardCornerRadius="20dp"
                app:cardElevation="2dp" android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/pcmso_program_section" android:textColor="@color/anda_navy"
                        android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="@string/pcmso_hint_program_name"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/pcmsoProgramNameInput" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:inputType="textCapSentences"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
                android:layout_height="wrap_content" app:cardCornerRadius="20dp"
                app:cardElevation="2dp" android:layout_marginBottom="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/pcmso_doctor_section" android:textColor="@color/anda_navy"
                        android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="@string/pcmso_hint_doctor"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="8dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/pcmsoDoctorInput" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:inputType="textPersonName|textCapWords"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="@string/pcmso_hint_crm"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="8dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/pcmsoCrmInput" android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="@string/pcmso_hint_clinic_name"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="8dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/pcmsoClinicNameInput" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:inputType="textCapWords"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="@string/pcmso_hint_clinic_cnpj"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="8dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/pcmsoClinicCnpjInput" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:inputType="number" android:maxLength="18"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="@string/pcmso_hint_year"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="8dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/pcmsoYearInput" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:inputType="number" android:maxLength="4"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="@string/pcmso_hint_risk_assessment"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/pcmsoRiskAssessmentInput" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:minLines="3"
                            android:gravity="top" android:inputType="textMultiLine"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="@string/pcmso_hint_observations"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_marginTop="8dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/pcmsoObservationsInput" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:minLines="2"
                            android:gravity="top" android:inputType="textMultiLine"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- EXAMS CARD -->
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
                android:layout_height="wrap_content" app:cardCornerRadius="20dp"
                app:cardElevation="2dp" android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/pcmso_exams_section" android:textColor="@color/anda_navy"
                        android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
                    <CheckBox android:id="@+id/pcmsoExamMedicalCheck"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/pcmso_exam_checkbox_medical" android:checked="true"/>
                    <CheckBox android:id="@+id/pcmsoExamAudiologyCheck"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/pcmso_exam_checkbox_audiology"/>
                    <CheckBox android:id="@+id/pcmsoExamSpirometryCheck"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/pcmso_exam_checkbox_spirometry"/>
                    <CheckBox android:id="@+id/pcmsoExamEcgCheck"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/pcmso_exam_checkbox_ecg"/>
                    <CheckBox android:id="@+id/pcmsoExamHemogramCheck"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/pcmso_exam_checkbox_hemogram2"/>
                    <CheckBox android:id="@+id/pcmsoExamVisualCheck"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/pcmso_exam_checkbox_visual"/>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="@string/pcmso_exam_other_hint"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_marginTop="8dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/pcmsoOtherExamsInput" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:inputType="textCapSentences"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SCHEDULE TYPES CARD -->
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
                android:layout_height="wrap_content" app:cardCornerRadius="20dp"
                app:cardElevation="2dp" android:layout_marginBottom="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/pcmso_schedule_section" android:textColor="@color/anda_navy"
                        android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
                    <CheckBox android:id="@+id/pcmsoScheduleReturnCheck"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/pcmso_schedule_return_label" android:checked="true"/>
                    <CheckBox android:id="@+id/pcmsoScheduleRemovalCheck"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/pcmso_schedule_removal_label" android:checked="true"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton android:id="@+id/generatePcmsoButton"
                android:layout_width="match_parent" android:layout_height="56dp"
                android:text="@string/pcmso_generate_button" android:textSize="15sp"
                android:layout_marginBottom="10dp" style="@style/Widget.Anda.Button"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/signPcmsoButton"
                android:layout_width="match_parent" android:layout_height="50dp"
                android:text="@string/pcmso_sign_button" android:layout_marginBottom="8dp"
                style="@style/Widget.Material3.Button.TonalButton"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/exportPcmsoPdfButton"
                android:layout_width="match_parent" android:layout_height="50dp"
                android:text="@string/pcmso_export_button" android:layout_marginBottom="16dp"
                style="@style/Widget.Material3.Button.OutlinedButton"/>

            <TextView
                android:id="@+id/pcmsoRequiredSummaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/pcmso_required_ready"
                android:textColor="@color/anda_text_secondary"
                android:textSize="12sp"/>

            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
                android:layout_height="wrap_content" app:cardCornerRadius="16dp" app:cardElevation="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp">
                    <TextView android:id="@+id/pcmsoStatusText" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="@string/pcmso_status_waiting"
                        android:textColor="@color/anda_text_secondary" android:textSize="13sp"/>
                    <TextView android:id="@+id/pcmsoPreviewText" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text=""
                        android:textColor="@color/anda_text_secondary" android:textSize="11sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>

