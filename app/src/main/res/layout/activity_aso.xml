<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/anda_bg">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/anda_navy">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp" android:paddingEnd="20dp"
            android:paddingTop="20dp" android:paddingBottom="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/aso_header_title" android:textColor="@color/white"
                android:textSize="26sp" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/aso_subtitle"
                android:textColor="@color/anda_navy_text_sub" android:textSize="13sp"
                android:layout_marginTop="2dp"/>
            <TextView android:id="@+id/asoDisclaimerText"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/aso_status_initial"
                android:textColor="@color/anda_navy_text_muted" android:textSize="11sp"
                android:layout_marginTop="6dp"/>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="16dp" android:paddingBottom="40dp">

            <!-- ── Empresa Card ─── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="20dp" app:cardElevation="2dp"
                android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/cat_company_section_title" android:textColor="@color/anda_navy"
                        android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:hint="@string/generic_doc_hint_company_cnpj"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/companyCnpjInput"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:inputType="number" android:maxLength="18"/>
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/lookupCompanyCnpjButton"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="8dp" android:layout_gravity="center_vertical"
                            android:text="@string/generic_doc_lookup_button" style="@style/Widget.Material3.Button.TonalButton"/>
                    </LinearLayout>
                    <TextView android:id="@+id/cnpjLookupStatusText"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="" android:textColor="@color/anda_navy_medium"
                        android:textSize="12sp" android:layout_marginBottom="4dp"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pickCompanyButton"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/aso_pick_company_button" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="@string/generic_doc_hint_company_name" style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="8dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/companyNameInput"
                            android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="@string/generic_doc_hint_company_cnae" style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/companyCnaeInput"
                            android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Tipo de Exame Card ─── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="20dp" app:cardElevation="2dp"
                android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/aso_exam_section_title" android:textColor="@color/anda_navy"
                        android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="10dp"/>
                    <Spinner android:id="@+id/examinationTypeSpinner"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:background="@drawable/spinner_background"
                        android:padding="12dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Funcionário Card ─── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="20dp" app:cardElevation="2dp"
                android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/aso_employee_section_title" android:textColor="@color/anda_navy"
                        android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>
                    <!-- Employee picker button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/pickEmployeeButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:text="@string/aso_pick_employee_button"
                        style="@style/Widget.Material3.Button.OutlinedButton" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="@string/aso_hint_employee_name"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="8dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/employeeNameInput"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="textPersonName|textCapWords"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="@string/aso_hint_employee_cpf"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/employeeCpfInput"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="number" android:maxLength="14"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Médico / Clínica Card ─── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="20dp" app:cardElevation="2dp"
                android:layout_marginBottom="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/aso_medical_section_title" android:textColor="@color/anda_navy"
                        android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="@string/aso_hint_doctor_name"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="8dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/doctorNameInput"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="textPersonName|textCapWords"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="@string/aso_hint_doctor_crm"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="8dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/doctorCrmInput"
                            android:layout_width="match_parent" android:layout_height="wrap_content"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="@string/aso_hint_clinic_name"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="8dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/clinicNameInput"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="textCapWords"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="@string/aso_hint_clinic_cnpj"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/clinicCnpjInput"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="number" android:maxLength="18"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Conclusão / Aptidão Card ─── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="20dp" app:cardElevation="2dp"
                android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/aso_conclusion_section_title"
                        android:textColor="@color/anda_navy"
                        android:textSize="14sp" android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <!-- APT / INAPTO radio group -->
                    <RadioGroup
                        android:id="@+id/conclusionRadioGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">
                        <RadioButton
                            android:id="@+id/radioApt"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/aso_result_apt"
                            android:textColor="@color/anda_text_primary"
                            android:textStyle="bold" />
                        <RadioButton
                            android:id="@+id/radioInapt"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/aso_result_inapt"
                            android:textColor="@color/anda_text_primary"
                            android:textStyle="bold" />
                        <RadioButton
                            android:id="@+id/radioInaptTemp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/aso_result_inapt_temp"
                            android:textColor="@color/anda_text_primary"
                            android:textSize="11sp" />
                    </RadioGroup>

                    <!-- Restrictions -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="@string/aso_hint_restrictions"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="8dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/restrictionsInput"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="2"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Complementary exams -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="@string/aso_hint_complementary_exams"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="8dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/complementaryExamsInput"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="2"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Observations -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="@string/aso_hint_observations"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/observationsInput"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="2"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Action Buttons ─── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/generateAsoButton"
                android:layout_width="match_parent" android:layout_height="56dp"
                android:text="@string/aso_generate_button" android:textSize="15sp"
                android:layout_marginBottom="10dp"
                style="@style/Widget.Anda.Button"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/signAsoButton"
                android:layout_width="match_parent" android:layout_height="50dp"
                android:text="@string/aso_sign_button"
                android:layout_marginBottom="8dp"
                style="@style/Widget.Material3.Button.TonalButton"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/exportAsoPdfButton"
                android:layout_width="match_parent" android:layout_height="50dp"
                android:text="@string/aso_export_button"
                android:layout_marginBottom="16dp"
                style="@style/Widget.Material3.Button.OutlinedButton"/>

            <TextView
                android:id="@+id/asoRequiredSummaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/aso_required_ready"
                android:textColor="@color/anda_text_secondary"
                android:textSize="12sp"/>

            <!-- ── Status Card ─── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="16dp" app:cardElevation="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp">
                    <TextView android:id="@+id/asoStatusText"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/aso_status_waiting"
                        android:textColor="@color/anda_text_secondary" android:textSize="13sp"/>
                    <TextView android:id="@+id/asoPreviewText"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:text=""
                        android:textColor="@color/anda_text_secondary" android:textSize="11sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
