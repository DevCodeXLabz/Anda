<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/anda_navy">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/anda_navy">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp"
            android:paddingTop="20dp" android:paddingBottom="12dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/scanner_title" android:textColor="@color/white"
                android:textSize="24sp" android:textStyle="bold"/>
            <TextView android:id="@+id/scannerStatusText"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/scanner_status_waiting_camera" android:textColor="@color/anda_navy_text_sub"
                android:textSize="13sp" android:layout_marginTop="4dp"/>
            <TextView android:id="@+id/backendHealthText"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/scanner_backend_checking" android:textColor="@color/anda_navy_text_muted"
                android:textSize="11sp" android:layout_marginTop="2dp"/>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Camera Preview -->
            <androidx.camera.view.PreviewView android:id="@+id/cameraPreview"
                android:layout_width="match_parent" android:layout_height="300dp"
                android:background="#0A0A0A"
                app:implementationMode="performance" app:scaleType="fillCenter"/>

            <!-- Content below camera -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@color/anda_bg"
                android:paddingStart="16dp" android:paddingEnd="16dp"
                android:paddingTop="16dp" android:paddingBottom="40dp">

                <!-- Actions -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/requestCameraButton"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:text="@string/scanner_request_camera_button"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.Anda.Button"/>

                <!-- Scan result card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp" app:cardElevation="2dp"
                    android:layout_marginBottom="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="14dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/scanner_result_title" android:textColor="@color/anda_navy"
                            android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
                        <TextView android:id="@+id/scanResultText"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/scanner_result_empty"
                            android:textColor="@color/anda_text_secondary" android:textSize="13sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Manual fallback card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp" app:cardElevation="1dp"
                    android:layout_marginBottom="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="14dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/scanner_manual_title" android:textColor="@color/anda_navy"
                            android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:hint="@string/scanner_manual_hint"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_marginBottom="8dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/mockOcrInput" android:layout_width="match_parent"
                                android:layout_height="wrap_content" android:minLines="2"
                                android:gravity="top" android:inputType="textMultiLine"/>
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/scanButton"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/scanner_manual_analyze_button"
                            style="@style/Widget.Material3.Button.TonalButton"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openOfficialConsultButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/scanner_open_official_button"
                    style="@style/Widget.Material3.Button.OutlinedButton"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
