<?xml version="1.0" encoding="utf-8"?>
<!--
    Data Extraction Rules for ANDA — API 31+.
    Devices on API 30 and below use backup_rules.xml.

    LGPD / Lei 13.709/2018 compliance:
      Cloud backup and device-to-device transfer are both fully excluded.
      The Room database contains AES-256-GCM-encrypted PII (companyCnpj,
      signedBy, payloadJson, etc.); shared preferences may hold session tokens;
      export directories contain signed medical documents (ASO, PCMSO).

    See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Entire Room database -->
        <exclude domain="database" path="." />
        <!-- SharedPreferences — session state / auth tokens -->
        <exclude domain="sharedpref" path="." />
        <!-- Exported documents and audit trails -->
        <exclude domain="file" path="exports/" />
        <exclude domain="file" path="pdfs/" />
        <exclude domain="file" path="audits/" />
        <!-- External storage -->
        <exclude domain="external" path="." />
    </cloud-backup>

    <device-transfer>
        <!-- Same policy for device-to-device transfers (e.g. Quick Switch) -->
        <exclude domain="database"   path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file"       path="exports/" />
        <exclude domain="file"       path="pdfs/" />
        <exclude domain="file"       path="audits/" />
        <exclude domain="external"   path="." />
    </device-transfer>
</data-extraction-rules>