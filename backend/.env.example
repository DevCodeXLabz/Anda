PORT=8080
LOG_LEVEL=info
CA_ADMIN_TOKEN=troque-este-token
CA_ADMIN_TOKEN_SHA256=
CA_ADMIN_IP_ALLOWLIST=
CA_ADMIN_BLOCK_RULES=
# Optional upstream used by the backend adapter (GET {CA_UPSTREAM_URL}/ca/{numero})
CA_UPSTREAM_URL=
CA_CACHE_TTL_MS=300000
CA_NEGATIVE_CACHE_TTL_MS=60000
CA_CACHE_PERSIST_ENABLED=true
CA_CACHE_FILE_PATH=.cache/ca-cache.json
CA_CACHE_FLUSH_DEBOUNCE_MS=1000
CA_UPSTREAM_TIMEOUT_MS=4000
CA_UPSTREAM_RETRIES=1
CA_FALLBACK_WINDOW_MS=300000
CA_RATE_LIMIT_WINDOW_MS=60000
CA_RATE_LIMIT_MAX=60
CA_WARMUP_ON_BOOT=false
CA_WARMUP_CAS=12345,98765

